# GitHub OAuth / PAT settings
# Optional: OAuth app credentials for interactive GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: a personal access token to enable private repo access without OAuth.
# This is used as a fallback when no active session token is present.
GITHUB_TOKEN=

# Session secret for secure cookies
SESSION_SECRET=replace-this-with-a-random-long-string

# Local server port
PORT=3000
